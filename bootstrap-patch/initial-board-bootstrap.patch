diff --git a/app/src/test/java/com/nothatcher/chessoverlay/regression/InitialBoardBootstrapRegressionTest.kt b/app/src/test/java/com/nothatcher/chessoverlay/regression/InitialBoardBootstrapRegressionTest.kt
