+++ b/app/src/main/java/com/nothatcher/chessoverlay/session/AnalysisPermission.kt
@@ -6,3 +6,9 @@ fun SessionMode.analysisPermission(): AnalysisPermission = when (this) {
     SessionMode.PRACTICE, SessionMode.POST_GAME_REVIEW -> AnalysisPermission.ALLOWED
     SessionMode.SCAN_ONLY -> AnalysisPermission.FORBIDDEN
 }
+
+fun SessionMode.allowsEngineHints(context: AnalysisContext): Boolean = when (this) {
+    SessionMode.SCAN_ONLY -> false
+    SessionMode.POST_GAME_REVIEW -> true
+    SessionMode.PRACTICE -> context.allowsEngineHints()
+}
