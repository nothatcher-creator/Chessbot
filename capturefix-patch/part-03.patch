+
+class OverlayDiagnosticsFormatterTest {
+    @Test
+    fun screenDiagnosticsExposeFenAndEngineState() {
+        val text = OverlayDiagnosticsFormatter.format(
+            source = "Screen",
+            fen = "rnbqkbnr/pppp1ppp/8/4p2Q/4P3/8/PPPP1PPP/RNB1KBNR b KQkq - 1 2",
+            engineState = "Stockfish starting",
+        )
+
+        assertTrue(text.contains("Source: Screen"))
+        assertTrue(text.contains("FEN:"))
+        assertTrue(text.contains("Stockfish starting"))
+    }
+}
