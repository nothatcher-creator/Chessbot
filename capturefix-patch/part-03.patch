+package com.nothatcher.chessoverlay.overlay.android
+
+import com.nothatcher.chessoverlay.overlay.geometry.BoardBounds
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class OverlayDockPlannerTest {
+    @Test
+    fun docksAboveBoardWhenThereIsRoom() {
+        val position = OverlayDockPlanner.place(
+            screenWidth = 710,
+            screenHeight = 1536,
+            controlWidth = 568,
+            controlHeight = 110,
+            board = BoardBounds(0f, 346f, 710f, 1056f),
+            marginPx = 12,
+        )
+
+        assertTrue(position.y + 110 <= 346 - 12)
+    }
+
+    @Test
+    fun neverPlacesControlOutsideScreen() {
+        val position = OverlayDockPlanner.place(
+            screenWidth = 400,
+            screenHeight = 700,
+            controlWidth = 300,
+            controlHeight = 180,
+            board = BoardBounds(0f, 80f, 400f, 620f),
+            marginPx = 12,
+        )
+
+        assertTrue(position.x in 0..100)
+        assertTrue(position.y in 0..520)
+    }
+}
