+package com.nothatcher.chessoverlay.capture
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class CaptureOverlaySyncTest {
+    @Test
+    fun requestAckReleaseHandshakeTracksHiddenTimestamp() {
+        CaptureOverlaySync.resetForTest()
+        CaptureOverlaySync.setOverlayPresent(true)
+
+        assertTrue(CaptureOverlaySync.requestHide())
+        assertTrue(CaptureOverlaySync.hideRequested.value)
+        assertNull(CaptureOverlaySync.hiddenSinceMs())
+
+        CaptureOverlaySync.acknowledgeHidden(1234L)
+        assertEquals(1234L, CaptureOverlaySync.hiddenSinceMs())
+
+        CaptureOverlaySync.releaseHide()
+        assertFalse(CaptureOverlaySync.hideRequested.value)
+        assertNull(CaptureOverlaySync.hiddenSinceMs())
+    }
+
+    @Test
+    fun requestHideIsSkippedWhenOverlayIsNotPresent() {
+        CaptureOverlaySync.resetForTest()
+        assertFalse(CaptureOverlaySync.requestHide())
+    }
+}
