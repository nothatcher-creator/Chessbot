+package com.nothatcher.chessoverlay.capture
+
+import org.junit.Assert.assertEquals
+import org.junit.Test
+
+class CaptureOverlayGateTest {
+    @Test
+    fun visibleOverlayMustBeHiddenAndSettledBeforeCapture() {
+        val gate = CaptureOverlayGate(settleMs = 40)
+
+        assertEquals(CaptureOverlayDecision.REQUEST_HIDE, gate.onFrame(1000, overlayPresent = true, hiddenSinceMs = null))
+        assertEquals(CaptureOverlayDecision.WAIT_FOR_HIDE, gate.onFrame(1010, overlayPresent = true, hiddenSinceMs = null))
+        assertEquals(CaptureOverlayDecision.WAIT_FOR_SETTLE, gate.onFrame(1030, overlayPresent = true, hiddenSinceMs = 1020))
+        assertEquals(CaptureOverlayDecision.CAPTURE, gate.onFrame(1060, overlayPresent = true, hiddenSinceMs = 1020))
+
+        gate.onCaptureComplete()
+        assertEquals(CaptureOverlayDecision.REQUEST_HIDE, gate.onFrame(1500, overlayPresent = true, hiddenSinceMs = null))
+    }
+
+    @Test
+    fun captureCanProceedImmediatelyWhenNoOverlayIsPresent() {
+        val gate = CaptureOverlayGate(settleMs = 40)
+        assertEquals(CaptureOverlayDecision.CAPTURE, gate.onFrame(1000, overlayPresent = false, hiddenSinceMs = null))
+    }
+}
