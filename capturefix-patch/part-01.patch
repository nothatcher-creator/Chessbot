@@ -0,0 +1,19 @@
+package com.nothatcher.chessoverlay.overlay.android
+
+object OverlayDiagnosticsFormatter {
+    fun format(
+        source: String?,
+        fen: String?,
+        engineState: String?,
+    ): String = buildString {
+        if (!source.isNullOrBlank()) append("Source: ").append(source)
+        if (!engineState.isNullOrBlank()) {
+            if (isNotEmpty()) append(" • ")
+            append(engineState)
+        }
+        if (!fen.isNullOrBlank()) {
+            if (isNotEmpty()) append('\n')
+            append("FEN: ").append(fen)
+        }
+    }
+}
