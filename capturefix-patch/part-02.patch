+        val rightX = board.right.toInt() + marginPx
+        if (rightX <= maxX) {
+            val centeredY = (((board.top + board.bottom) / 2f) - controlHeight / 2f).toInt().coerceIn(0, maxY)
+            return OverlayDockPosition(rightX.coerceIn(0, maxX), centeredY)
+        }
+
+        return OverlayDockPosition(centeredX, 0.coerceIn(0, maxY))
+    }
