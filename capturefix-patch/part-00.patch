diff --git a/app/src/main/java/com/nothatcher/chessoverlay/capture/CaptureOverlayGate.kt b/app/src/main/java/com/nothatcher/chessoverlay/capture/CaptureOverlayGate.kt
new file mode 100644
index 0000000..a3bac44
--- /dev/null
+++ b/app/src/main/java/com/nothatcher/chessoverlay/capture/CaptureOverlayGate.kt
@@ -0,0 +1,44 @@
+package com.nothatcher.chessoverlay.capture
+
+enum class CaptureOverlayDecision {
+    CAPTURE,
+    REQUEST_HIDE,
+    WAIT_FOR_HIDE,
+    WAIT_FOR_SETTLE,
+}
+
+class CaptureOverlayGate(
+    private val settleMs: Long = 40L,
+) {
+    private var hideRequested = false
+
+    init {
+        require(settleMs >= 0L)
+    }
+
+    fun onFrame(
+        nowMs: Long,
+        overlayPresent: Boolean,
+        hiddenSinceMs: Long?,
+    ): CaptureOverlayDecision {
+        if (!overlayPresent) return CaptureOverlayDecision.CAPTURE
+        if (!hideRequested) {
+            hideRequested = true
+            return CaptureOverlayDecision.REQUEST_HIDE
+        }
+        val hiddenAt = hiddenSinceMs ?: return CaptureOverlayDecision.WAIT_FOR_HIDE
+        return if (nowMs - hiddenAt >= settleMs) {
+            CaptureOverlayDecision.CAPTURE
+        } else {
+            CaptureOverlayDecision.WAIT_FOR_SETTLE
+        }
+    }
+
+    fun onCaptureComplete() {
+        hideRequested = false
+    }
+
+    fun reset() {
+        hideRequested = false
+    }
+}
diff --git a/app/src/main/java/com/nothatcher/chessoverlay/capture/CaptureOverlaySync.kt b/app/src/main/java/com/nothatcher/chessoverlay/capture/CaptureOverlaySync.kt
new file mode 100644
index 0000000..503d690
--- /dev/null
+++ b/app/src/main/java/com/nothatcher/chessoverlay/capture/CaptureOverlaySync.kt
@@ -0,0 +1,43 @@
+package com.nothatcher.chessoverlay.capture
+
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.asStateFlow
+
+object CaptureOverlaySync {
+    private val _hideRequested = MutableStateFlow(false)
+    val hideRequested: StateFlow<Boolean> = _hideRequested.asStateFlow()
+
+    @Volatile private var overlayPresent = false
+    @Volatile private var hiddenSince: Long? = null
+
+    fun setOverlayPresent(present: Boolean) {
+        overlayPresent = present
+        if (!present) releaseHide()
+    }
+
+    fun isOverlayPresent(): Boolean = overlayPresent
+
+    fun requestHide(): Boolean {
+        if (!overlayPresent) return false
+        hiddenSince = null
+        _hideRequested.value = true
+        return true
+    }
+
+    fun acknowledgeHidden(nowMs: Long) {
+        if (overlayPresent && _hideRequested.value) hiddenSince = nowMs
+    }
+
+    fun hiddenSinceMs(): Long? = hiddenSince
+
+    fun releaseHide() {
+        hiddenSince = null
+        _hideRequested.value = false
+    }
+
+    internal fun resetForTest() {
+        overlayPresent = false
+        releaseHide()
+    }
+}
